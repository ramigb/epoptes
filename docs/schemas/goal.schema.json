{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal.schema.json",
  "title": "Epoptes goal (.epoptes/goal.json)",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "kind",
    "objective",
    "done",
    "timebox",
    "adapter"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "code",
        "research",
        "content",
        "data",
        "other"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "done": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "check",
          "verify"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "verify": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "command",
                  "file",
                  "agent",
                  "manual"
                ]
              },
              "run": {
                "type": "string",
                "description": "shell command, for type=command"
              },
              "path": {
                "type": "string",
                "description": "file that must exist, for type=file"
              }
            }
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "the main deliverable: a path relative to the project (file or folder) or an http(s) URL. The dashboard links to it; `epoptes event output` overrides it at run time"
    },
    "timebox": {
      "type": "object",
      "required": [
        "total_min"
      ],
      "additionalProperties": false,
      "properties": {
        "total_min": {
          "type": "integer",
          "minimum": 5
        },
        "wrapup_min": {
          "type": "integer",
          "minimum": 0,
          "default": 60
        },
        "grace_min": {
          "type": "integer",
          "minimum": 0,
          "default": 45
        },
        "pause_on_rate_limit": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "checkpoints": {
      "enum": [
        "git",
        "shadow",
        "none"
      ],
      "default": "git"
    },
    "adapter": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "claude-code",
            "codex"
          ]
        },
        "prompt": {
          "type": "string",
          "default": "loop.md"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "default": "high"
        },
        "permission_mode": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "codex"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "default": ""
              },
              "permission_mode": {
                "enum": [
                  "read-only",
                  "workspace-write",
                  "danger-full-access"
                ],
                "default": "workspace-write"
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "default": "opus"
              },
              "permission_mode": {
                "default": "auto"
              }
            }
          }
        }
      ]
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_min": {
          "type": "integer",
          "minimum": 20,
          "maximum": 180,
          "default": 90
        },
        "pause_between_s": {
          "type": "integer",
          "minimum": 0,
          "default": 15
        },
        "max_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null
        }
      },
      "default": {}
    },
    "failures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cooldown_after": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "cooldown_min": {
          "type": "integer",
          "minimum": 0,
          "default": 10
        },
        "give_up_after": {
          "type": "integer",
          "minimum": 1,
          "default": 6
        }
      },
      "default": {}
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoff_s": {
          "type": "integer",
          "minimum": 30,
          "default": 300
        },
        "backoff_max_s": {
          "type": "integer",
          "minimum": 30,
          "default": 1800
        }
      },
      "default": {}
    },
    "state_caps": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      },
      "default": {
        "handoff.md": 25,
        "lessons.md": 30
      }
    },
    "notify": {
      "type": "array",
      "items": {
        "enum": [
          "milestone",
          "blocked",
          "done",
          "wrapup",
          "run.end",
          "warn"
        ]
      },
      "default": [
        "milestone",
        "blocked",
        "done"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "properties": {
              "type": {
                "const": "codex"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "cycle": {
            "properties": {
              "max_budget_usd": {
                "type": "null",
                "description": "Codex exec has no dollar budget cap; use null."
              }
            }
          }
        }
      }
    }
  ]
}
