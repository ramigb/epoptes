{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "Runner status (.epoptes/run/status.json)",
  "type": "object",
  "required": [
    "version",
    "state",
    "pid",
    "run",
    "cycle",
    "mode",
    "heartbeat_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "state": {
      "enum": [
        "idle",
        "running",
        "waiting",
        "rate_limited",
        "cooldown",
        "pausing",
        "paused",
        "needs_input",
        "stopped",
        "crashed",
        "failed",
        "done",
        "timeboxed"
      ]
    },
    "pid": {
      "type": [
        "integer",
        "null"
      ]
    },
    "run": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^r[0-9]+$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0,
      "description": "last started cycle; 0 = none yet"
    },
    "mode": {
      "enum": [
        "build",
        "wrapup",
        "overtime",
        "stop",
        "followup",
        null
      ]
    },
    "cycle_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "heartbeat_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "waiting_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "wait_reason": {
      "enum": [
        "rate_limit",
        "cooldown",
        "between_cycles",
        null
      ]
    },
    "pause_requested": {
      "type": "boolean",
      "default": false
    },
    "fails_in_row": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "description": "latest plan usage report from the adapter (Claude Code streams it; Codex's comes from its session log)",
      "properties": {
        "status": {
          "type": "string"
        },
        "resets_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "windows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "utilization": {
                "type": "number"
              },
              "resets_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "description": "the adapter whose account this is: claude-code or codex; missing means claude-code"
        }
      }
    },
    "live_usage": {
      "type": [
        "object",
        "null"
      ],
      "description": "token use of the running cycle so far, for CLIs that report it mid-cycle (claude-code: tokens; pi: tokens and cost). Cleared when the cycle ends.",
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "type": "integer",
                "minimum": 0
              },
              "cache_read": {
                "type": "integer",
                "minimum": 0
              },
              "cache_write": {
                "type": "integer",
                "minimum": 0
              },
              "cost_usd": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "needs": {
      "type": [
        "object",
        "null"
      ],
      "description": "set while state is needs_input: what the orchestrator is waiting for",
      "required": [
        "reason",
        "since"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "since": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
