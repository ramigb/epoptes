{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feedback.schema.json",
  "title": "One line of .epoptes/feedback.jsonl",
  "type": "object",
  "required": [
    "ts",
    "op",
    "id"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "op": {
      "enum": [
        "add",
        "status",
        "note",
        "decide"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^F-[0-9]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "add"
          }
        }
      },
      "then": {
        "required": [
          "text",
          "src"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "enum": [
              "dashboard",
              "cli",
              "file",
              "orchestrator"
            ]
          },
          "kind": {
            "enum": [
              "feedback",
              "approval"
            ],
            "default": "feedback",
            "description": "approval: the orchestrator asks the human before doing something on the approval list"
          },
          "ref": {
            "type": "string",
            "description": "backlog task id the item is about"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "by"
        ],
        "properties": {
          "status": {
            "enum": [
              "new",
              "seen",
              "in_progress",
              "done",
              "blocked",
              "wont_do"
            ]
          },
          "by": {
            "enum": [
              "orchestrator",
              "user"
            ]
          },
          "cycle": {
            "type": [
              "integer",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "note"
          }
        }
      },
      "then": {
        "required": [
          "text",
          "by"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "by": {
            "enum": [
              "orchestrator",
              "user"
            ]
          },
          "cycle": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "decide"
          }
        }
      },
      "then": {
        "required": [
          "decision",
          "by"
        ],
        "properties": {
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "by": {
            "enum": [
              "orchestrator",
              "user"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  ]
}
