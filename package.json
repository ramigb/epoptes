{
  "name": "@ramigb/epoptes",
  "version": "0.1.0",
  "description": "Create, run, watch and steer long-running Claude Code harnesses",
  "type": "module",
  "license": "MIT",
  "bin": {
    "epoptes": "bin/epoptes.mjs"
  },
  "files": [
    "bin",
    "dist",
    "docs/schemas",
    "ui",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "epoptes": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "htm": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "harness",
    "autonomous",
    "long-running",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramigb/epoptes.git"
  },
  "homepage": "https://github.com/ramigb/epoptes#readme",
  "bugs": {
    "url": "https://github.com/ramigb/epoptes/issues"
  }
}
